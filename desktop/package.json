{
  "name": "haikoradio-desktop",
  "productName": "HaikoRadio",
  "version": "0.1.4",
  "description": "HaikoRadio — la webradio, en application Windows",
  "author": "OmégaCraft",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/dist.js",
    "publish": "node scripts/publish.js"
  },
  "build": {
    "appId": "fr.omgacraft.haikoradio",
    "productName": "HaikoRadio",
    "copyright": "© OmégaCraft",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/tray.png"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "HaikoRadio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HaikoRadio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OmgaCraft",
        "repo": "HaikoRadio",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
