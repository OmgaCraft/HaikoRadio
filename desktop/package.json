{
  "name": "haikoradio-desktop",
  "productName": "HaikoRadio",
  "version": "0.1.4",
  "description": "HaikoRadio — la webradio, application de bureau (Windows et Linux)",
  "author": "OmégaCraft",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/dist.js",
    "publish": "node scripts/publish.js",
    "dist:linux": "node scripts/dist.js linux"
  },
  "build": {
    "appId": "fr.omgacraft.haikoradio",
    "productName": "HaikoRadio",
    "copyright": "© OmégaCraft",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/tray.png"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "HaikoRadio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HaikoRadio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OmgaCraft",
        "repo": "HaikoRadio",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "La webradio HaikoRadio",
      "description": "Écoute HaikoRadio en direct : morceau en cours avec pochette, historique et planning de la semaine.",
      "maintainer": "OmégaCraft <contact@omgacraft.fr>",
      "executableName": "haikoradio",
      "artifactName": "HaikoRadio-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://radio.omgacraft.fr"
}
